# Local Postgres from `docker compose up -d db`. On Neon, use the *pooled* connection string here
# and the direct one in DATABASE_URL_UNPOOLED (migrations and seeding need a real session).
DATABASE_URL=postgresql://lexio:lexio@localhost:5433/lexio
# DATABASE_URL_UNPOOLED=

# gemini (production) | local (fastembed, no key, dev/eval only) | hash (tests)
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=

GROQ_API_KEY=

# Public demo: read-only samples, capped questions (see README, "Running a public demo").
# DEMO_MODE=true
# VISITOR_SALT=change-me
# TRUST_FORWARDED_FOR=true   # only behind a proxy that sets X-Forwarded-For itself (Vercel does)

# Sign-in: the backend verifies tokens the web app signs with this shared secret (32+ characters,
# `openssl rand -base64 32`). Empty means anonymous-only: nobody can sign in.
# API_TOKEN_SECRET=
# ALLOW_DEV_USERS=true       # local development only: accept the frontend's test login
# USER_MAX_DOCUMENTS=10
# USER_MAX_MB=50

# Where the web app may call this API from, as a JSON list (default: http://localhost:3000).
# CORS_ORIGINS=["https://lexio-web.vercel.app"]

# Vercel Blob (see DEPLOY.md): when set, PDFs go browser -> Blob -> POST /api/documents/register
# and are kept in Blob, not Postgres. It must be the token of the store the web app uploads to.
# BLOB_READ_WRITE_TOKEN=
# UPLOAD_TICKET_LIMIT=30     # uploads a user may start per day (unregistered ones are junk in Blob)

# Optional Langfuse tracing of chats: timings and flags only, unless CAPTURE_CONTENT is on.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_CAPTURE_CONTENT=false
