# Local Postgres from `docker compose up -d db`. On Neon, use the *pooled* connection string.
DATABASE_URL=postgresql://lexio:lexio@localhost:5433/lexio

# gemini (production) | local (fastembed, no key, dev/eval only) | hash (tests)
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=

GROQ_API_KEY=

# Public demo: read-only samples, capped questions (see README, "Running a public demo").
# DEMO_MODE=true
# VISITOR_SALT=change-me
# TRUST_FORWARDED_FOR=true   # only behind a proxy that sets X-Forwarded-For itself (Vercel does)
