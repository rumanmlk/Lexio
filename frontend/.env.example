# Where the FastAPI backend lives (it must list this site in its CORS_ORIGINS).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sign-in (Auth.js). Copy this file to .env.local and fill it in.
# AUTH_SECRET encrypts the session cookie:   openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials). Authorised
# redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Shared with the backend's API_TOKEN_SECRET (32+ characters): this app signs a 5-minute token
# for the API with it. A different value from AUTH_SECRET.
API_TOKEN_SECRET=
